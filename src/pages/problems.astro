---
import Base from '../layouts/Base.astro';
import { getRecentProblems } from '../lib/db';

export const prerender = false;

let problems: Awaited<ReturnType<typeof getRecentProblems>> = [];
let dbError = false;
try {
  problems = await getRecentProblems(100);
} catch {
  dbError = true;
}

function ago(ts: number): string {
  const s = Math.floor((Date.now() - ts) / 1000);
  if (s < 60) return 'just now';
  const m = Math.floor(s / 60);
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  return `${Math.floor(h / 24)}d ago`;
}
---

<Base title="Problems on the board" description="Every problem people have asked, and the solutions stacking up under each.">
  <div class="head">
    <p class="eyebrow">The board</p>
    <h1 class="head__title">Every problem asked, and its solutions.</h1>
    <p class="head__lede">
      Real problems people brought in. Each has an AI solution and any the
      community added. Open one to read it, add your own, or vote the best up.
    </p>
    <a class="head__cta" href="/#ask">Ask your own problem &rarr;</a>
  </div>

  {dbError ? (
    <p class="empty">The board is briefly unavailable. Try again in a moment.</p>
  ) : problems.length === 0 ? (
    <p class="empty">No problems yet. <a href="/#ask">Be the first to ask one.</a></p>
  ) : (
    <ul class="plist">
      {problems.map((p) => (
        <li class="pitem">
          <a href={`/p/${p.id}/`}>
            <div class="pitem__main">
              <p class="pitem__text">{p.text}</p>
              {p.top_title && <p class="pitem__top mono">Top solution: {p.top_title}</p>}
            </div>
            <div class="pitem__meta">
              <span class={`pitem__count ${p.solution_count > 0 ? 'has' : 'none'}`}>
                {p.solution_count} solution{p.solution_count === 1 ? '' : 's'}
              </span>
              <span class="pitem__ago mono">{ago(p.created_at)}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .head { border-bottom: 2px solid var(--ink); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
  .head__title { font-size: clamp(1.9rem, 5vw, 3.25rem); font-weight: 700; margin: 0.3rem 0 1rem; max-width: 18ch; }
  .head__lede { font-size: clamp(1.05rem, 2.5vw, 1.25rem); max-width: 58ch; color: var(--ink-soft); margin: 0 0 1rem; }
  .head__cta { font-family: var(--font-mono); font-size: 0.8rem; color: var(--profit-deep); }

  .empty { color: var(--ink-soft); padding: 2rem 0; }
  .empty a { color: var(--profit-deep); }

  .plist { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .pitem a {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1.15rem 0; border-bottom: 1px solid var(--rule-strong);
    text-decoration: none; color: var(--ink);
  }
  .pitem:first-child a { border-top: 1px solid var(--rule-strong); }
  .pitem a:hover .pitem__text { color: var(--profit-deep); }
  .pitem__text { font-size: clamp(1.05rem, 2.2vw, 1.25rem); margin: 0; max-width: 52ch; overflow-wrap: anywhere; }
  .pitem__top { font-size: 0.72rem; color: var(--ink-soft); margin: 0.3rem 0 0; }
  .pitem__meta { display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem; text-align: right; white-space: nowrap; }
  .pitem__count { font-family: var(--font-mono); font-size: 0.72rem; padding: 0.2rem 0.55rem; border-radius: 999px; }
  .pitem__count.has { background: color-mix(in srgb, var(--profit) 15%, transparent); color: var(--profit-deep); }
  .pitem__count.none { background: color-mix(in srgb, var(--signal) 12%, transparent); color: var(--signal); }
  .pitem__ago { font-size: 0.7rem; color: var(--ink-soft); }

  @media (max-width: 560px) {
    .pitem a { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    .pitem__meta { flex-direction: row; align-items: center; gap: 0.75rem; }
  }
</style>
